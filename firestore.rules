rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{messageId} {
      // Anyone can create a document (submit form)
      allow create: if true;
      // No one can read, update, or delete from the client side
      allow read, update, delete: if false;
    }
    match /bookings/{bookingId} {
      // Allow creation of bookings (done server-side mostly, but just in case)
      allow create: if false; // Creation is handled purely by /api/book on Vercel
      allow read, update, delete: if false; // Only accessible via Vercel Admin SDK
    }
  }
}
